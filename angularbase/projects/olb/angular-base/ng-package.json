{
  "$schema": "../../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../../dist/olb/angular-base",
  "assets": [
    {
      "input": "./assets/styles",
      "glob": "**/*.scss",
      "output": "styles"
    },
    "./assets/**/*.*"
  ],
  "lib": {
    "entryFile": "src/public-api.ts",
    "styleIncludePaths": ["./assets/styles"]
  }
}
