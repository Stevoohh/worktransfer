{
  "name": "olbangularbase",
  "version": "22.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve -o --proxy-config proxy.conf.json --watch",
    "build": "ng build",
    "build-lib": "ng build --project=@olb/angular-base --watch",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --project=@olb/angular-base --no-watch --browsers=Headless --code-coverage",
    "test-local": "ng test --project=@olb/angular-base --browsers=Standard --code-coverage",
    "lint": "ng lint --project=@olb/angular-base",
    "sonar": "sonar-scanner"
  },
  "prettier": "@olb/prettier-config",
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.0.2",
    "@angular/cdk": "^22.0.2",
    "@angular/common": "^22.0.2",
    "@angular/compiler": "^22.0.2",
    "@angular/core": "^22.0.2",
    "@angular/forms": "^22.0.2",
    "@angular/material": "^22.0.2",
    "@angular/material-moment-adapter": "^22.0.2",
    "@angular/platform-browser": "^22.0.2",
    "@angular/platform-browser-dynamic": "^22.0.2",
    "@angular/router": "^22.0.2",
    "@types/file-saver": "^2.0.5",
    "exceljs": "^4.3.0",
    "fast-xml-parser": "^4.2.4",
    "file-saver": "^2.0.5",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "moment": "^2.30.1",
    "rxjs": "^7.8.2",
    "simplemattable": "^22.0.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.4",
    "@angular/cli": "~22.0.4",
    "@angular/compiler-cli": "^22.0.2",
    "@eslint/js": "^10.0.1",
    "@olb/eslint-config": "^1.1.0",
    "@olb/prettier-config": "^1.1.0",
    "@types/file-saver": "^2.0.5",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^26.0.1",
    "angular-eslint": "22.0.0",
    "baseline-browser-mapping": "^2.9.19",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^15.9.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "karma-sonarqube-reporter": "^1.4.0",
    "ng-packagr": "^22.0.0",
    "prettier-eslint": "^17.1.1",
    "sonar-scanner": "^3.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.60.1"
  }
}
